# ---------------------------------------------------------------------------
# Skin Affairs — backend environment
# Copy to .env and fill in. The server is deployed separately from the client.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------

# MongoDB connection string WITHOUT a database name — the app appends
# /SkinAffairs itself.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Any long random string; used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Google AI Studio key — the chat runs on Gemini via its OpenAI-compatible API.
GEMINI_API_KEY=

# Port for local development (hosting platforms set this themselves).
PORT=3000

# Where the frontend is deployed. Used for Stripe redirects, and as the
# default CORS allow-list when ALLOWED_ORIGINS is not set.
CLIENT_URL=http://localhost:5173

# Optional ------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call this API. Leave
# empty to allow any origin (fine for local dev, not for production).
# ALLOWED_ORIGINS=https://skinaffairs.vercel.app,https://www.skinaffairs.com

# ImageKit — stores photos users attach so they survive in chat history.
# Without these, photos are still analysed by the AI but are not kept.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Stripe — credit purchases. Without these the Credits page reports that
# payments aren't configured; everything else keeps working.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ClipDrop — AI image generation endpoint (/api/message/image).
CLIPDROP_API_KEY=
